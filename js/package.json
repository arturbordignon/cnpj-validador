{
  "name": "@lib-cnpj/js",
  "version": "1.0.0",
  "description": "Fast CNPJ validation and formatting for JavaScript, supporting numeric and alphanumeric formats.",
  "type": "module",
  "main": "dist/cnpj.cjs",
  "module": "dist/cnpj.esm.js",
  "browser": "dist/cnpj.umd.js",
  "exports": {
    ".": {
      "import": "./dist/cnpj.esm.js",
      "require": "./dist/cnpj.cjs",
      "default": "./dist/cnpj.umd.js"
    }
  },
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests benchmark",
    "lint:fix": "eslint src tests benchmark --fix",
    "benchmark": "node benchmark/benchmark.js",
    "check": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cnpj",
    "brazil",
    "validation",
    "alphanumeric",
    "tax-id",
    "jquery",
    "umd"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "rollup": "^4.62.4"
  }
}
